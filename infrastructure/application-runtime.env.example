# Local PostgreSQL deployment preparation ONLY; not an activated configuration.
# Copy to ../.env.application-runtime.local and fill the five blank values below.
# Do not use with base Compose alone: it still selects PG16 and old volumes.
# A separate PG17 local override, restore and target binding must be verified
# before startup. Existing Mumbai env/approval files must remain unchanged.

# REQUIRED: four DIFFERENT freshly generated 64-character hexadecimal secrets.
# Do not paste Supabase credentials, real secrets into Git, or secrets into chat.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RESULT_API_TOKEN=
REVIEW_API_TOKEN=

# REQUIRED identity, not a password: e.g. ritwik_dev (letters/digits/_/-).
# Assign each authorized reviewer their own identity and review token.
REVIEWER_ID=

# Local account/database names; no remote Supabase URI is needed.
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=15432
REDIS_PORT=16379
API_PORT=18000
WEB_PORT=15173
COMPOSE_PROJECT_NAME=sentinel-ai

# Proposed NEW persistent volumes. Do not substitute existing laptop volumes.
# These names become active only through the reviewed local Compose override.
LOCAL_POSTGRES_IMAGE=postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
LOCAL_POSTGRES_VOLUME=sentinel-ai-postgres-pg17-data
LOCAL_REDIS_VOLUME=sentinel-ai-redis-streams-data

# Derived by Compose; change the password fields above, not each URI manually.
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=${POSTGRES_URL}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# Host administrative tools use the mapped loopback port; React uses neither URI.
HOST_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# Preserve the existing imported application run/model/gate identity.
# These are identifiers/checksums, NOT credentials or authorization to activate.
SCORING_RUN_ID=c5b2dab3-0330-4a32-9ba7-82c85d311b40
SCORING_ACTIVATION_HOLD=1
SCORING_BUNDLE_SHA256=1e421627b7548e2a35de0e598fea23baa6996e316106346652d004c46d24d696
SCORING_GATE_REPORT_SHA256=abdffc8e3e90bfe040c72577de795e48a7d514e6de470adcf7dfb9732a2e18c2

# For another checkout, adapt the repository path; keep the frozen files intact.
SENTINEL_REPO_ROOT="C:/Final Year Project/Sentinel-AI---Financial-Fraud-Detector"
SCORING_BUNDLE_DIR=${SENTINEL_REPO_ROOT}/services/ml/artifacts/frozen/random-forest/20261002T075558874195Z
SCORING_GATE_DIR=${SENTINEL_REPO_ROOT}/services/ml/reports/final-test/1e421627b7548e2a35de0e598fea23baa6996e316106346652d004c46d24d696

# Same candidate images and pipeline settings; these require the local override.
APPLICATION_API_IMAGE=sentinel-ai-api:application
SCORING_WORKER_IMAGE=sentinel-ai-scoring-worker:random-forest
APPLICATION_DASHBOARD_IMAGE=sentinel-ai-dashboard:application
SCORING_CONCURRENCY=2
POSTGRES_POOL_MIN=3
POSTGRES_POOL_MAX=3
PUBLISHER_POOL_MAX=1
PUBLISHER_BATCH_SIZE=2
STREAM_BATCH_SIZE=2
STREAM_POLL_MS=50
STREAM_BLOCK_MS=2000
STREAM_CLAIM_IDLE_MS=10000
STREAM_MAX_ATTEMPTS=5
STREAM_RETENTION=10000
STREAM_NAME=authorization.events.v1
STREAM_DEAD_LETTER_NAME=authorization.events.v1.dead-letter
SCORING_PROFILE=1
INGESTION_PROFILE=1
PUBLISHER_PROFILE=1
READINESS_TIMEOUT_SECONDS=2

# Deadline remains 1000 ms, enforced by code/database; no env override is provided.
# Do not add the Mumbai target pin or remote PGSSL settings to this local profile.
# New target attestation and separate qualification metadata are migration steps.
