# Independent local development. Copy with scripts/new-teammate-env.ps1.
# Use fresh credentials, a fresh run and separate empty volumes on YOUR machine.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RESULT_API_TOKEN=
REVIEW_API_TOKEN=
REVIEWER_ID=
SCORING_RUN_ID=

POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
POSTGRES_PORT=15432
REDIS_PORT=16379
API_PORT=18000
WEB_PORT=15173
LOCAL_POSTGRES_IMAGE=postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24
LOCAL_POSTGRES_VOLUME=sentinel-team-postgres-data
LOCAL_REDIS_VOLUME=sentinel-team-redis-data

# These dedicated tags can be built from source or assigned to trusted images.
APPLICATION_API_IMAGE=sentinel-ai-api:development
SCORING_WORKER_IMAGE=sentinel-ai-scoring-worker:random-forest-development
APPLICATION_DASHBOARD_IMAGE=sentinel-ai-dashboard:development
APPLICATION_DATABASE_TARGET_SHA256=9a9816b70974d622cd050febd6c50203453dc52e5ca6a711e0c2e2623dd387df
SCORING_ACTIVATION_HOLD=1
SCORING_BUNDLE_SHA256=1e421627b7548e2a35de0e598fea23baa6996e316106346652d004c46d24d696
SCORING_GATE_REPORT_SHA256=abdffc8e3e90bfe040c72577de795e48a7d514e6de470adcf7dfb9732a2e18c2
SENTINEL_REPO_ROOT=
SCORING_BUNDLE_DIR=${SENTINEL_REPO_ROOT}/services/ml/artifacts/frozen/random-forest/20261002T075558874195Z
SCORING_GATE_DIR=${SENTINEL_REPO_ROOT}/services/ml/reports/final-test/1e421627b7548e2a35de0e598fea23baa6996e316106346652d004c46d24d696

POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_URL=${POSTGRES_URL}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
STREAM_NAME=authorization.events.v1
STREAM_DEAD_LETTER_NAME=authorization.events.v1.dead-letter
STREAM_BATCH_SIZE=2
STREAM_POLL_MS=50
STREAM_BLOCK_MS=2000
STREAM_CLAIM_IDLE_MS=10000
STREAM_MAX_ATTEMPTS=5
STREAM_RETENTION=10000
READINESS_TIMEOUT_SECONDS=2
