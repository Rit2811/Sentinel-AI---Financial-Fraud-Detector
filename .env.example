# Sentinel AI local-development placeholders only. Never use these values in a
# shared, staging, or production environment and never commit a real `.env`.

COMPOSE_PROJECT_NAME=sentinel-ai
API_PORT=18000
WEB_PORT=15173
POSTGRES_PORT=15432
REDIS_PORT=16379

POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_local_only
REDIS_PASSWORD=sentinel_local_only
READINESS_TIMEOUT_SECONDS=2

# Task 4 Redis Stream controls. These are names and limits, not secrets.
STREAM_NAME=authorization.events.v1
STREAM_DEAD_LETTER_NAME=authorization.events.v1.dead-letter
STREAM_CONSUMER_GROUP=fraud-proof-v1
STREAM_CONSUMER_PURPOSE=task4-proof-consumer
STREAM_BATCH_SIZE=50
STREAM_BLOCK_MS=2000
STREAM_CLAIM_IDLE_MS=10000
STREAM_POLL_MS=500
STREAM_MAX_ATTEMPTS=5
STREAM_RETENTION=10000

# Optional protected Task 6 result API preparation. Keep blank until configured.
# Generate a private local token of at least 32 characters; never commit it.
RESULT_API_TOKEN=
SCORING_RUN_ID=

# Separate local review credential bound to a single authorized reviewer identity.
# Keep these blank until explicitly provisioning that reviewer; never reuse RESULT_API_TOKEN.
REVIEW_API_TOKEN=
REVIEWER_ID=

# Gated worker profile; do not set before the exact package passes its authorized test.
SCORING_BUNDLE_SHA256=
SCORING_BUNDLE_DIR=
SCORING_GATE_REPORT_SHA256=
SCORING_GATE_DIR=
